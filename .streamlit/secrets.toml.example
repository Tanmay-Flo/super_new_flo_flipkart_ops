# --------------------------------------------------------------------
# COPY this file to ".streamlit/secrets.toml" and put your real values.
# secrets.toml is listed in .gitignore - it must NEVER be committed.
# --------------------------------------------------------------------

[mongo]
uri = "mongodb+srv://USERNAME:PASSWORD@flobridgedb.xa97s.mongodb.net"
database = "Test"
collection = "allorders"

[flipkart]
# Flipkart Seller API application credentials (Basic Auth for the token call)
username = "YOUR_FLIPKART_APP_ID"
password = "YOUR_FLIPKART_APP_SECRET"

# true  = build the API requests and show them, but send NOTHING to Flipkart
# false = real dispatch
dry_run = false

[auth]
# App login. Generate these with:  python generate_password_hash.py
username = "YOUR_LOGIN_USERNAME"
password_salt = "PASTE_SALT_HERE"
password_hash = "PASTE_HASH_HERE"
